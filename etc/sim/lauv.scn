<?xml version="1.0"?>
<!--
    LAUV robot template.

    Include this together with a world (e.g. basic.scn) and pass ALL of the
    arguments below (Stonefish has no argument defaults; a missing one is a
    hard parse error):

        <scenario>
            <include file="basic.scn"/>
            <include file="lauv.scn">
                <arg name="name" value="lauv-1"/>
                <arg name="mass" value="33.0"/>
                <arg name="cg_x" value="0.0795"/>
                <arg name="cg_y" value="0.0"/>
                <arg name="cg_z" value="0.009"/>
                <arg name="pos_n" value="0.0"/>
                <arg name="pos_e" value="0.0"/>
                <arg name="pos_yaw" value="0.0"/>
            </include>
        </scenario>

    name   robot name; must match the DUNE system name ([General] Vehicle
           in the .ini) of the node running Simulators.StoneFish. With several
           robots, each must be named after the vehicle it represents; the task
           binds a robot to its IMC system from the EntityList that system
           announces (so "<name>/imu" data is dispatched from that system). A
           single robot whose name does not match is taken as the local one.
    pos_n/pos_e/pos_yaw  initial pose of the robot in the world NED frame:
           north [m], east [m] and heading [rad]. Space vehicles apart so they
           do not spawn on top of each other.
    mass   hull dry mass [kg]; displaced volume is 0.0326 m^3 (33.4 kg of
           water), so < 33.4 floats and > 33.4 sinks.
    cg_x/y/z  hull centre of gravity [m] in the hull frame (X fwd, Y stbd,
           Z down). The centre of buoyancy is NOT settable: Stonefish puts
           it at the volume centroid of lauv_hull_phy.obj (x = +0.082).
           Submerged pitch trim = atan((cg_x_combined - cb_x) / BG), so trim
           is millimetre-sensitive in cg_x. Use etc/sim/lauv_trim.py to
           compute/balance these values (see etc/sim/README.md).

    Geometry generated from lauv.STL (millimeters), converted to meters and
    centered: X forward, Y starboard, Z down. Hull is ~1.93 m long with a
    0.074 m radius. Meshes:
      - lauv_hull.obj      detailed visual (fins and propeller removed)
      - lauv_hull_phy.obj  low-poly solid of revolution for physics
      - lauv_fin_*.obj     tail fins, modeled about their pivot point

    Tail has 4 fins in a '+' layout plus one thruster. 
    DUNE SetServoPosition ids are the actuator document order, chosen
    to match Control.AUV.Allocator:
      0: top      (vertical, yaw)
      1: starboard (horizontal, pitch)
      2: port     (horizontal, pitch) 
      3: bottom    (vertical, yaw)
-->
<scenario>
    <robot name="$(arg name)" fixed="false" self_collisions="false">
        <base_link name="hull" type="model" physics="submerged">
            <physical>
                <mesh filename="lauv_hull_phy.obj" scale="1.0"/>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            </physical>
            <visual>
                <mesh filename="lauv_hull.obj" scale="1.0"/>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            </visual>
            <material name="Hull"/>
            <look name="yellow"/>
            <!-- Mass and CG come from include arguments (see header).
                 The CG must sit (nearly) under the mesh volume centroid (= CB, x = +0.082) 
                 or the vehicle pitches until CB is above CG. 
                 Tune with etc/sim/lauv_trim.py. -->
            <mass value="$(arg mass)"/>
            <inertia xyz="0.5 10.0 10.0"/>
            <cg xyz="$(arg cg_x) $(arg cg_y) $(arg cg_z)" rpy="0.0 0.0 0.0"/>
        </base_link>

        <!-- Tail control surfaces are modeled as Stonefish 'rudder'
             actuators (see the actuator section below), NOT as separate
             revolute fin links. A thin fin link weighs only ~27 g, three
             orders of magnitude lighter than the 33 kg hull; that mass
             ratio makes the multibody system stiff and the explicit
             integrator diverges (velocities blow up, flipping sign every
             step) after a few deflections. A rudder actuator instead
             applies an analytic lift/drag force directly to the hull, so
             there is no light dynamic link and no instability. -->

        <!-- Setpoints from DUNE (SetThrusterActuation) are normalized [-1, 1]. -->
        <actuator name="thruster_surge" type="thruster">
            <!-- max_setpoint is the propeller speed [rad/s] at full action 1.0
                 (zero_order rotor: omega = setpoint). rpm = omega*30/pi.
                 max_omega is a SEPARATE, absolute cap on the achieved rotor
                 speed (local Stonefish patch: ZeroOrder now honors
                 RotorDynamics::outputLimit; Thruster::setMaxOmega sets it
                 independently of max_setpoint/setpointLimit). Without it the
                 zero_order rotor tracks any commanded rpm exactly, so the
                 rpm sweep's steady-u vs commanded-rpm curve grows linearly
                 forever — no propeller thrust-coefficient tuning can bend
                 that curve over (thrust and quadratic hull drag are both
                 homogeneous degree-2 in (n,u), so the equilibrium u/n ratio
                 is scale-invariant for ANY kt(J) shape). The field rpm sweep
                 shows the real cause is a motor/ESC limit, not hydrodynamics:
                 telemetry Rpm during xp6_1600rpm/xp6_1800rpm plateaus at the
                 same ~1300-1400 rpm regardless of the (1600 vs 1800) command,
                 matching the "1400" top breakpoint every LAUV variant's
                 'Power Model -- Conversion - RPM' config uses. 146.6 rad/s =
                 1400 rpm. -->
            <specs max_setpoint="261.8" max_omega="146.6" inverted_setpoint="false" normalized_setpoint="true"/>
            <propeller diameter="0.113" right="true">
                <mesh filename="propeller.obj" scale="1.0"/>
                <material name="Aluminum"/>
                <look name="gray"/>
            </propeller>
            <rotor_dynamics type="zero_order"/>
            <!-- Advance-ratio ('fluid_dynamics') propeller model: thrust falls
                 off with vehicle speed like a real propeller —
                   T = rho * D^3 * ktp * |n| * (D*n - u),  n = omega/(2*pi) [rev/s]
                 so thrust -> 0 at advance ratio J = u/(n*D) = 1. The previous
                 'quadratic' model (T = kt*omega^2) was speed-INDEPENDENT, so
                 StoneFish kept climbing past the field vehicle's ~1.45 m/s
                 saturation (over-predicted surge by +0.4 m/s at 1600-1800 rpm;
                 see ~/example-sim-logs/sweep). ktp tuned against the
                 lauv-xplore-4 field rpm sweep (forward=reverse; torque_coeff is
                 reaction roll only, the zero_order rotor ignores prop load).
                 ktp=0.85 minimises steady-u RMS over the 800-1400 rpm band
                 (the common operating range, ~0.06). NOTE ktp was 1.10 while
                 the vehicle still weaved through every leg (yaw limit cycle,
                 fixed 2026-07 via hull body lift + yaw-fin retune) — the
                 weave added drag, so the straight-line calibration was hot:
                 once the path was clean the same thrust ran +0.16..+0.46 m/s
                 over the field sweep. 1600-1800 rpm (rarely commanded) still
                 over-predict ~0.25-0.31 m/s — the field's flat saturation is
                 flatter than any single-coeff advance-ratio model.
                 (ktp=0.418 = old quadratic bollard kt=0.00177 at u=0.) -->
            <thrust_model type="fluid_dynamics">
                <!-- alpha/beta decouple the kt(J)/kq(J) slope from the J=0
                     intercept (local Stonefish patch, ActuatorDynamics.h;
                     without the attributes the lib falls back to
                     alpha=-forward). kt0=2.5, alpha=-3.88 keeps the same
                     steady rpm->u map as the old 0.85/-0.85 pair (fitted to
                     the lauv-xplore-4 800-1400 rpm band) but raises
                     off-equilibrium thrust ~3x (bollard 25->74 N at 800 rpm,
                     zero-thrust advance ratio J0 = kt0/|alpha| = 0.64) so
                     low-rpm acceleration and in-turn speed recovery are no
                     longer starved: at 800 rpm Goto2 track-separation RMS
                     fell 14.3->8.4 m and in-turn u_min rose 0.50->0.64
                     (field 0.68); at 1200 rpm sep RMS 5.3->2.5 m. A/B swept
                     kt0 = 0.85/1.5/2.5 along the constant-steady-map valley;
                     gains were monotonic up to 2.5. -->
                <thrust_coeff forward="2.5" reverse="2.5" alpha="-3.88"/>
                <torque_coeff value="0.125" beta="-0.194"/>
            </thrust_model>
            <!-- Propeller mesh (propeller.obj) is extracted from lauv.STL and
                 recentered on its rotation axis, so this origin is the real
                 propeller blade/thrust centre in the hull frame. The mesh
                 carries the shaft forward (local x +0.153, world x -0.782) so
                 it meets the hull tail cone; the blades trail aft to x -0.966. -->
            <origin xyz="-0.9348 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <link name="hull"/>
        </actuator>

        <!-- The Stonefish rudder rotates about its local Z and produces lift
             along its local Y. So:
               - yaw fins (top, bottom): actuator frame = hull frame, rpy 0.
               - pitch fins (starboard, port): actuator frame rolled +90 deg
                 about X so local Z -> hull Y (deflection) and local Y ->
                 hull Z (force); the visual mesh is rolled back -90 deg so it
                 still renders as a horizontal fin.. -->
        <!-- Yaw fins: tuned with the hull body-lift coefficients
             (Simulators.StoneFish 'Hull Body Lift Coefficients', see
             etc/stonefish.ini) against the lauv-xplore-4 field sweep.
             The field's max-rudder yaw rate is nearly SPEED-INDEPENDENT
             (~0.14 rad/s at u=0.78 and u=1.2), while the bare Rudder model
             scales lift with u^2 — so the YAW fins carry an 'inflow' term
             (patched local Stonefish: constant axial flow along hull +X,
             the propeller race over the tail) and a lower lift_coeff.
             lift_coeff 8 + inflow 0.6 keeps the ceiling at K_eff ~= 0.33
             (field 0.31) at BOTH 800 and 1200 rpm. Tuning traps (see
             tasks/lessons.md 2026-07-19): inflow adds vectorially
             ((u+p)^2 cross term), suppresses the fin's flow-angle feedback
             (~1.46x gain per unit moment) and cuts the fin's weathervane
             yaw DAMPING — larger inflow with smaller lift_coeff makes the
             yaw rate INSENSITIVE (even inverted) to lift_coeff as the hull
             Munk moment takes over. 8/0.6 is the stable sweet spot; the
             body-lift knobs (etc/stonefish.ini) move together with these.
             drag_coeff IS honored by the patched Rudder (Engelhardtsen drag
             with its own coefficient): 6 gives L/D ~= 5 at full deflection;
             the old lib used lift_coeff there (28 -> ~10 N fin drag at full
             rudder, ~2x hull drag — the cause of the deep in-turn surge
             loss). -->
        <actuator name="fin_top" type="rudder">
            <specs area="0.0080" lift_coeff="8.0" drag_coeff="6.0" inflow="0.6" max_angle="0.45" stall_angle="0.6" max_angular_rate="5.24" inverted="false"/>
            <visual>
                <mesh filename="lauv_fin_top.obj" scale="1.0"/>
                <material name="Hull"/>
                <look name="yellow"/>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            </visual>
            <origin xyz="-0.7077 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <link name="hull"/>
        </actuator>

        <actuator name="fin_starboard" type="rudder">
            <!-- inverted: a pitch fin rolled +90 deg produces a nose-up
                 moment for DUNE's nose-down (dive) command, so flip it.
                 lift_coeff 24: at 6 the pitch fins saturate nose-down yet
                 the +0.38 kg buoyant hull pitches only ~7 deg and never
                 dives; VSIM uses symmetric fin forces. Pitch fins keep
                 inflow=0 and drag_coeff=lift_coeff (exact legacy Rudder
                 behavior): giving them the yaw fins' inflow term triples
                 their force at low speed, and a stern fin dives by lifting
                 the TAIL — at the surface at u~0.4 that plows the bow down
                 instead of flying the vehicle under (u capped ~0.4 at 1600
                 rpm, never dove; see tasks/todo.md milestone 3d). -->
            <specs area="0.0080" lift_coeff="24.0" drag_coeff="24.0" inflow="0.0" max_angle="0.45" stall_angle="0.6" max_angular_rate="5.24" inverted="true"/>
            <visual>
                <mesh filename="lauv_fin_starboard.obj" scale="1.0"/>
                <material name="Hull"/>
                <look name="yellow"/>
                <origin xyz="0.0 0.0 0.0" rpy="-1.5708 0.0 0.0"/>
            </visual>
            <origin xyz="-0.7077 0.0 0.0" rpy="1.5708 0.0 0.0"/>
            <link name="hull"/>
        </actuator>

        <actuator name="fin_port" type="rudder">
            <!-- inverted: pitch fin, same as starboard (see above). -->
            <specs area="0.0080" lift_coeff="24.0" drag_coeff="24.0" inflow="0.0" max_angle="0.45" stall_angle="0.6" max_angular_rate="5.24" inverted="true"/>
            <visual>
                <mesh filename="lauv_fin_port.obj" scale="1.0"/>
                <material name="Hull"/>
                <look name="yellow"/>
                <origin xyz="0.0 0.0 0.0" rpy="-1.5708 0.0 0.0"/>
            </visual>
            <origin xyz="-0.7077 0.0 0.0" rpy="1.5708 0.0 0.0"/>
            <link name="hull"/>
        </actuator>

        <actuator name="fin_bottom" type="rudder">
            <specs area="0.0080" lift_coeff="8.0" drag_coeff="6.0" inflow="0.6" max_angle="0.45" stall_angle="0.6" max_angular_rate="5.24" inverted="false"/>
            <visual>
                <mesh filename="lauv_fin_bottom.obj" scale="1.0"/>
                <material name="Hull"/>
                <look name="yellow"/>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            </visual>
            <origin xyz="-0.7077 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <link name="hull"/>
        </actuator>

        <sensor name="IMU" type="imu" rate="50.0">
            <link name="hull"/>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        </sensor>

        <sensor name="pressure" type="pressure" rate="10.0">
            <link name="hull"/>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        </sensor>

        <sensor name="GPS" type="gps" rate="1.0">
            <link name="hull"/>
            <origin xyz="0.0 0.0 -0.15" rpy="0.0 0.0 0.0"/>
        </sensor>

        <sensor name="DVL" type="dvl" rate="5.0">
            <link name="hull"/>
            <origin xyz="0.0 0.0 0.15" rpy="3.1416 0.0 0.0"/>
            <range velocity="9.0 9.0 9.0" altitude_min="0.2" altitude_max="80.0"/>
        </sensor>

        <sensor name="gyro" type="gyro" rate="50.0">
            <link name="hull"/>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        </sensor>

        <sensor name="compass" type="compass" rate="10.0">
            <link name="hull"/>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        </sensor>

        <world_transform xyz="$(arg pos_n) $(arg pos_e) 0.0" rpy="0.0 0.0 $(arg pos_yaw)"/>
    </robot>
</scenario>
